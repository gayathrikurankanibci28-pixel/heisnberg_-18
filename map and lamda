def fibonacci(n):
    # Handle edge cases for 0 or 1
    if n == 0:
        return []
    if n == 1:
        return [0]
    
    # Starting sequence
    fib = [0, 1]
    # Build the sequence up to n
    for i in range(2, n):
        fib.append(fib[i-1] + fib[i-2])
    return fib
