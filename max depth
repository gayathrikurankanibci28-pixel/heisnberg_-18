
import xml.etree.ElementTree as etree

maxdepth = 0
def depth(elem, level):
    global maxdepth
    # Update maxdepth if the current level is deeper
    if level + 1 > maxdepth:
        maxdepth = level + 1
        
    # Recursively check children, incrementing the level
    for child in elem:
        depth(child, level + 1)

  
